CONFIG_IDF_TARGET="esp32s3"

# Flash do Stamp-S3A: 8 MB. DIO e o modo mais compativel; QIO e mais rapido
# (troque se quiser, mas use o mesmo modo no platformio.ini e no flash.sh).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Mesma tabela de particoes do sistema
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Log INFO: mostra no serial para onde o boot foi
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# Sem rollback: o Orbita controla o otadata sozinho
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
